# Revel — a deployment's worth of environment.
#
# Copy to `.env` and fill in. Everything here is optional in the sense that the
# server starts without it; several of them are optional in the way a lock on
# the door is optional.
#
# Nothing in this file is a secret. `REVEL_HOST_KEY` deliberately is not here —
# see below.

# --- what this Host calls itself -------------------------------------------

# The public name of this Host, without a scheme. Used in device certificates
# and in the addresses people give each other, so changing it after anybody has
# signed up is not a rename, it is a different Host.
REVEL_HOST=revel.chat

# The IdP that vouches for accounts. Usually the same machine.
REVEL_IDP=revel.chat

# Which shard mints snowflakes here. **Must differ per Host** or two of them
# will hand out the same ids, which is the kind of bug that surfaces months
# later as two rooms sharing an event.
REVEL_SHARD=1

# --- storage ----------------------------------------------------------------

DATABASE_URL=postgres://revel:revel@localhost:5432/revel

# Where encrypted blobs go. Unset keeps them in Postgres, which works and does
# not enjoy it.
# REVEL_BLOB_DIR=/var/lib/revel/blobs

# --- keys -------------------------------------------------------------------

# The Host's signing key, as a file. Generate with `pnpm host-key`.
# `REVEL_HOST_KEY` takes the contents inline instead, for platforms with no
# writable disk. Keep both out of version control.
REVEL_HOST_KEY_FILE=/var/lib/revel/host-key.json

# --- behind a proxy ---------------------------------------------------------

# Off by default and it has to be: trusting `X-Forwarded-For` from a client
# that reaches the server directly lets anyone claim any address, which turns
# every per-address rate limit into a formality. Set it only when something in
# front is actually rewriting the header.
# REVEL_TRUST_PROXY=1

# Loosen rate limits by this factor. For tests. Never in production.
# REVEL_RATE_SCALE=50

# --- security disclosure (`docs/34`) ----------------------------------------

# Unset means `/.well-known/security.txt` is not served at all, which is the
# right answer for a Host with nobody reading the address. A file pointing at
# an inbox nobody opens is worse than no file.
REVEL_SECURITY_CONTACT=mailto:security@revel.chat
REVEL_SECURITY_POLICY=https://revel.chat/security
