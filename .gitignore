# Rust
target/

# Node
node_modules/
dist/
.svelte-kit/

# wasm-bindgen output. Generated by `pnpm build:wasm`; the sources are
# crates/revel-crypto. package.json and README.md are checked in so the
# workspace resolves before anyone has built it.
packages/crypto-wasm/*
!packages/crypto-wasm/package.json
!packages/crypto-wasm/README.md

# Incremental build state for `tsc --build`. Machine-local, rewritten on every
# typecheck, and meaningless to anybody else — it was tracked by accident and
# showed up as a modified file in every single commit.
*.tsbuildinfo

# OS
.DS_Store

# Logs and scratch
*.log
/tmp/
revel-host.json

# Secrets, and the near-misses.
#
# `.env.example` is checked in and is the documentation; `.env` is the one with
# the database password in it. The host key is worse: `docs/36` explains that
# neither key inside it can be regenerated, so a copy in a public repository is
# not a rotation, it is every account on that Host.
.env
.env.*
!.env.example
*host-key*.json
*.pem
