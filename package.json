{
  "name": "revel",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter @revel/web dev",
    "dev:server": "pnpm --filter @revel/server dev",
    "build": "pnpm --filter @revel/web build",
    "preview": "pnpm --filter @revel/web preview",
    "test": "vitest run",
    "test:rust": "cargo test -p revel-crypto",
    "typecheck": "tsc --build --force",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@types/node": "^26.4.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
