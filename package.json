{
  "name": "revel",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter @revel/web dev",
    "dev:server": "pnpm --filter @revel/server dev",
    "host-key": "pnpm --filter @revel/server host-key",
    "build": "pnpm --filter @revel/web build",
    "build:wasm": "bash scripts/build-wasm.sh",
    "bench:wasm": "echo '\\n  open http://localhost:8787/bench/wasm/\\n' && python3 -m http.server 8787",
    "bench:worker": "pnpm --filter @revel/bench-worker dev",
    "preview": "pnpm --filter @revel/web preview",
    "test": "vitest run",
    "test:rust": "cargo test -p revel-crypto",
    "test:passkey": "node apps/web/e2e/passkey.mjs",
    "test:live": "node apps/web/e2e/live.mjs",
    "test:budgets": "node apps/web/e2e/budgets.mjs",
    "test:faces": "node apps/web/e2e/faces.mjs",
    "test:livechat": "node apps/web/e2e/livechat.mjs",
    "test:mobile": "node apps/web/e2e/mobile.mjs",
    "test:unread": "node apps/web/e2e/unread.mjs",
    "test:offline": "node apps/web/e2e/offline.mjs",
    "test:devices": "node apps/web/e2e/devices.mjs",
    "test:degraded": "node apps/web/e2e/degraded.mjs",
    "test:reload": "node apps/web/e2e/reload.mjs",
    "test:spaces": "node apps/web/e2e/spaces.mjs",
    "test:wasm": "cargo test -p revel-crypto --target wasm32-unknown-unknown --test wasm",
    "typecheck": "tsc --build --force",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@types/node": "^26.4.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
